{
  "manifest_version": 3,
  "name": "aigent Browser Bridge",
  "version": "0.1.0",
  "description": "Connects your browser to the aigent agent.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3141/*",
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": ["http://localhost:3141/*"]
  },
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}

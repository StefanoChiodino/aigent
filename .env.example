# --- Claude (default) ---
ANTHROPIC_API_KEY=sk-ant-...
AIGENT_MODEL=claude-opus-4-6

# --- Local model ---
# AIGENT_PROVIDER=local
# AIGENT_MODEL=llama3.2:3b
# AIGENT_THINKING=off

# --- External OpenAI-compatible ---
# AIGENT_PROVIDER=openai
# AIGENT_BASE_URL=http://host.docker.internal:8080/v1
# OPENAI_API_KEY=not-needed
# AIGENT_MODEL=my-model

# Thinking effort: off | low | medium | high | max
AIGENT_THINKING=medium

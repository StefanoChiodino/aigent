# =============================================================================
# aigent — Environment Variables
# Copy this file to .env and fill in the values you need.
# =============================================================================

# --- Provider selection ---
# Explicit provider override. Auto-detected if omitted:
#   - ANTHROPIC_API_KEY set → anthropic
#   - AIGENT_BASE_URL set   → openai
#   - OPENAI_API_KEY only   → openai
# AIGENT_PROVIDER=anthropic    # 'anthropic' | 'openai'

# --- Anthropic (default) ---
ANTHROPIC_API_KEY=sk-ant-...
AIGENT_MODEL=claude-opus-4-6

# --- OpenAI or OpenAI-compatible (e.g. LM Studio, Ollama, vLLM) ---
# AIGENT_PROVIDER=openai
# AIGENT_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_API_KEY=not-needed        # or real key for openai.com
# AIGENT_API_KEY=not-needed        # fallback if OPENAI_API_KEY not set
# AIGENT_MODEL=qwen/qwen2.5-coder-14b

# --- Model behaviour ---
# Thinking effort for extended reasoning (Anthropic Opus only).
# off | low | medium | high | max
AIGENT_THINKING=medium

# --- Tool control ---
# Set to 1 to disable sending tool definitions to the model.
# Useful for local models that don't support function calling.
# AIGENT_NO_TOOLS=1

# Comma-separated allowlist of tools to send to the model.
# All other tools are excluded. Ignored if AIGENT_NO_TOOLS=1.
# Available tools: exec, read_file, write_file, edit_file, patch,
#   grep, glob, list_files, tree, fetch, screenshot,
#   dispatch_task, spawn_agent, switch_model, host,
#   request_mount, request_config_write
# AIGENT_TOOLS_ALLOWLIST=exec,read_file,write_file,request_mount

# --- Prompt size ---
# Set to 1 to skip MEMORY.md from the system prompt (saves tokens).
# Useful for small context windows (< 8k).
# AIGENT_SLIM_PROMPT=1

# Set to 1 to include full recent session logs in the system prompt.
# Default: only an index is included; agent reads logs on demand.
# AIGENT_FULL_LOGS=1

# --- Workspace ---
# Path to the workspace directory (AGENTS.md, SOUL.md, memory/, etc.)
# Defaults to /workspace inside the container.
# AIGENT_WORKSPACE=/workspace

# --- Server ports ---
# Port for the web UI (default: 3141)
# AIGENT_WEB_PORT=3141

# --- Logging ---
# Log level: DEBUG | INFO | WARN | ERROR (default: INFO)
# AIGENT_LOG_LEVEL=INFO

# Enable verbose debug output (same as AIGENT_LOG_LEVEL=DEBUG)
# AIGENT_DEBUG=1

# --- Speech (future / OS bridge) ---
# URL for speech-to-text service
# AIGENT_STT_URL=http://127.0.0.1:8765
# URL for text-to-speech service
# AIGENT_TTS_URL=http://127.0.0.1:8766

{
  "name": "aigent",
  "version": "1.0.1",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aigent": "dist/host/daemon.js",
    "aigent-host": "dist/host/daemon.js"
  },
  "files": [
    "dist/",
    "web/dist/",
    "src/workspace-templates/",
    "aigent-extension/build.mjs",
    "aigent-extension/manifest.json",
    "aigent-extension/background/",
    "aigent-extension/popup/",
    "aigent-extension/pip/",
    "aigent-extension/package.json",
    "aigent-extension/tsconfig.json",
    "stt/main.py",
    "stt/requirements.txt",
    "tts/main.py",
    "tts/requirements.txt",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "build-release": "npm run build && npm run web:build",
    "dev": "tsx src/gatekeeper.tsx --headless",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run web:build",
    "test": "node --import tsx/esm --test src/**/*.test.ts",
    "test:web": "vitest run --config web/vite.config.ts",
    "test:web-watch": "vitest --config web/vite.config.ts",
    "test:e2e": "AIGENT_TEST_MODE=1 AIGENT_WEB_PORT=3142 playwright test --config tests/playwright.config.ts",
    "test:e2e-live": "AIGENT_TEST_MODE=1 AIGENT_WEB_PORT=3142 playwright test --config tests/playwright.config.ts --grep @live",
    "test:e2e-ui": "AIGENT_TEST_MODE=1 AIGENT_WEB_PORT=3142 playwright test --config tests/playwright.config.ts --ui",
    "web:build": "vite build --config web/vite.config.ts",
    "web:watch": "vite build --config web/vite.config.ts --watch",
    "web:dev": "vite --config web/vite.config.ts",
    "web:typecheck": "tsc --noEmit --project web/tsconfig.json",
    "web:demo": "VITE_DEMO=true vite --config web/vite.config.ts",
    "web:demo-build": "VITE_DEMO=true vite build --config web/vite.config.ts --mode demo",
    "ext:build": "cd aigent-extension && npm install && node build.mjs",
    "ext:dev": "cd aigent-extension && npm install && node build.mjs --watch",
    "ext:typecheck": "tsc --noEmit --project aigent-extension/tsconfig.json"
  },
  "keywords": [
    "ai",
    "agent",
    "claude",
    "anthropic",
    "llm",
    "self-modifying",
    "cli",
    "automation",
    "mcp"
  ],
  "author": "Stefano Chiodino <mannii@aigent.dev>",
  "license": "MIT",
  "description": "A self-modifying AI agent platform — runs Claude locally, edits its own source, controls your browser, and speaks back.",
  "repository": {
    "type": "git",
    "url": "https://github.com/StefanoChiodino/aigent.git"
  },
  "homepage": "https://github.com/StefanoChiodino/aigent#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.75.0",
    "@types/ws": "^8.18.1",
    "@xenova/transformers": "^2.17.2",
    "chalk": "^5.6.0",
    "diff2html": "^3.4.56",
    "dotenv": "^17.3.1",
    "highlight.js": "^11.11.1",
    "ink": "^6.7.0",
    "ink-spinner": "^5.0.0",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.3",
    "marked-terminal": "^7.3.0",
    "minimatch": "^10.2.2",
    "openai": "^6.22.0",
    "react": "^19.2.4",
    "typescript": "^5.9.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@fission-ai/openspec": "^1.2.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.3",
    "jsdom": "^28.1.0",
    "react-dom": "^19.2.4",
    "tsx": "^4.21.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "zustand": "^5.0.11"
  }
}
